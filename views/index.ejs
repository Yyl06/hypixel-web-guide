<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/"><span>GUIDE</span></a>
    <span class="status-pill"><span class="status-dot"></span> Player resources</span>
  </header>

  <main class="home-page">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">The unofficial guides</p>
        <p class="hero-title">Everything you need to be better than <em>Koebatz.</em></p>
      </div>
      <div class="hero-mark" aria-hidden="true">K</div>
    </section>

    <section class="section-heading">
      <div>
        <p class="eyebrow">Guides</p>
        <p class="section-title">Choose your route</p>
      </div>
      <span class="section-count">01 section</span>
    </section>

    <nav class="guide-menu" aria-label="Game guide sections">
      <p class="guide-entry">
        <span class="button-number">01</span>
        <a href="/guides">Farming Guide</a>
        <span class="guide-description">Progression</span>
        <span class="button-arrow" aria-hidden="true">&rarr;</span>
      </p>
    </nav>
  </main>

  <footer class="site-footer">
    <span>Farming Guide</span>
  </footer>
</body>
</html>
